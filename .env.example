# Govee API - see https://developer.govee.com/reference/apply-you-govee-api-key
GOVEE_API_KEY=

GOVEE_DEVICE_STUDY_LIGHT_MAC_ADDR=
GOVEE_MODEL_STUDY_LIGHT=

GOVEE_DEVICE_SMART_PLUG_MAC_ADDR=
GOVEE_MODEL_SMART_PLUG=

# Comma-separated list of your fob(s)' fixed rolling-code id(s), as decoded by
# `rtl_433 -F json` (the "id" field). Add more (comma-separated) if you pair a
# second same-protocol fob later - no code change needed, just this and new
# manifest.json entries keyed off "<id>:<button>".
FOB_IDS=
FOB_MODEL=Microchip-HCS200

# rtl_433 protocol id for Microchip HCS200/HCS300 KeeLoq (OOK). Confirmed against
# rtl_433 25.02 - if it mismatches after an rtl_433 upgrade, run
# `rtl_433 -R help | grep -i hcs200` to find the current number.
RTL433_PROTOCOL_ID=131

# How often rtl_433 emits a liveness heartbeat regardless of button presses.
RTL433_STATS_INTERVAL=60

# How long to keep event/system_event rows before the retention job deletes them.
RETENTION_SECONDS=864000

# Timeout (seconds) for every Govee HTTP call.
GOVEE_TIMEOUT_SECONDS=8

# Where the SQLite DB and heartbeat file live inside the container (mounted as
# a volume in docker-compose.yml so it survives rebuilds).
DATA_DIR=/app/data
